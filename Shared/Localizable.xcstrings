    "build.expiry.days %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Build expires in %lld day. Run it again from Xcode."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Build expires in %lld days. Run it again from Xcode."
                }
              }
            }
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Build berakhir dalam %lld hari. Jalankan ulang dari Xcode."
          }
        }
      }
    },

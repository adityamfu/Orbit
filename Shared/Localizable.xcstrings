{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "backup.error.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file isn't a valid Orbit backup."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File ini bukan backup Orbit yang valid."
          }
        }
      }
    },
    "backup.error.newer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup was made by a newer version of Orbit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup ini dibuat oleh versi Orbit yang lebih baru."
          }
        }
      }
    },
    "backup.error.restore": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup couldn't be restored. Your data wasn't changed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup gagal dipulihkan. Data kamu tidak berubah."
          }
        }
      }
    },
    "backup.error.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import failed"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor gagal"
          }
        }
      }
    },
    "backup.export": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export backup"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspor backup"
          }
        }
      }
    },
    "backup.import": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import backup"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor backup"
          }
        }
      }
    },
    "backup.import.confirm.message %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in Orbit will be replaced with the backup from %@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua data di Orbit akan diganti dengan backup dari %@."
          }
        }
      }
    },
    "backup.import.confirm.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace all data?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti semua data?"
          }
        }
      }
    },
    "backup.import.final.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes, replace"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya, ganti"
          }
        }
      }
    },
    "backup.import.final.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current data will be lost. This can't be undone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data saat ini akan hilang dan tidak bisa dikembalikan."
          }
        }
      }
    },
    "backup.import.final.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakin?"
          }
        }
      }
    },
    "backup.import.replace": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replace all"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti semua"
          }
        }
      }
    },
    "backup.last %@": {
      "extractionState": "manual",
      "localizations": {
